<mujoco model="g1 manifold low-ceiling demo">
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0.55 0 0.65" extent="2.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- The underside is at z=1.17 m.  The accepted crouch primitive's measured
         mesh top is 0.92--1.09 m, while nominal walking reaches 1.24--1.29 m. -->
    <geom name="obstacle_low_ceiling" type="box" pos="0.55 0 1.21"
      size="0.85 0.90 0.04" rgba="0.95 0.30 0.18 0.48"/>
    <geom name="obstacle_left_marker" type="box" pos="0.55 0.93 0.58"
      size="0.85 0.03 0.58" rgba="0.95 0.55 0.18 0.22"/>
    <geom name="obstacle_right_marker" type="box" pos="0.55 -0.93 0.58"
      size="0.85 0.03 0.58" rgba="0.95 0.55 0.18 0.22"/>
  </worldbody>
</mujoco>
